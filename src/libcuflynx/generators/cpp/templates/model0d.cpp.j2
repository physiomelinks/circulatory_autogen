int makeDirectories(const std::string &path)
{
    std::string partial;
    std::stringstream ss(path);
    std::string item;
    if (!path.empty() && path[0] == '/') {
        partial = "/";
    }
    while (std::getline(ss, item, '/')) {
        if (item.empty()) {
            continue;
        }
        partial += item + "/";
