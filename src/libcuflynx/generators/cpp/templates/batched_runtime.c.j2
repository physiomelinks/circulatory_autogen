{% block description %}
/* Runtime of libcuflynx's BE_batched_c solver for {{ model_name }}.
   Generated by libcuflynx.generators.cpp.batched; regenerate instead of editing.

   Each block of states (see batched_kernels.c) is integrated on its own by an adaptive, L-stable implicit
   one-step method: backward Euler (first order), or TR-BDF2 (second order: a trapezoidal stage to
   t + gamma h, then BDF2; Hosea & Shampine 1996, as MATLAB's ode23tb).
   - Every stage solves y - c - a f(t, y) = 0 (a = h for backward Euler, gamma h / 2 for both TR-BDF2
     stages) by modified Newton: the exact Jacobian and the LU factors (partial pivoting) of I - a J are kept
     across iterations and steps, and redone when Newton converges slowly or fails, after max_jacobian_age
     steps, or when a changes (factors only). Newton has converged when its update, scaled by the observed
     rate of convergence, is below newton_tol of the error tolerance (as CVODES tests it): the residual
     itself can be all rounding error in a stiff state. A stage's rate is then (y - c) / a.
   - The local error estimate (backward Euler: 0.5 h (f1 - f0); TR-BDF2: Hosea & Shampine's, from the three
     rates), weighted by rtol * (largest |y| so far) + atol, sets the step. When it would reject the step it
     is filtered through (I - a J)^-1 (as Radau5 does), so a fast mode the method damps correctly does not
     count as error. After a rejected step the next step does not grow.
   - output times are interpolated (cubic Hermite, from the states and rates at both ends of a step), so
     steps are not cut at outputs;
   - the step size changes only when the error control asks for more than 20% growth (or any shrink), so the
     LU factors serve several steps;
   - a block continues its step across calls unless something it reads changed (its inputs, or the states
     set from outside), when it restarts from the given states with a short step. With
     bk_set_stop_at_outputs, steps end on each run's last output time instead of passing it, and a block whose
     inputs changed there keeps its step size, Jacobian and LU factors: a caller that changes inputs at
     every call (a game's macro step) then costs little more than one that does not;
   - an input may follow a protocol trace (bk_set_trace): a piecewise-linear function of the model's time,
     held at its end values outside its range, read at every rate and Jacobian evaluation. Steps end on the
     trace's breakpoints, so each step sees one straight piece of it.
   Blocks are independent, so they run on any number of OpenMP threads with bit-identical results. */
{% endblock %}
#include <float.h>
#include <math.h>
#include <stdlib.h>
#include <string.h>
#ifdef _OPENMP
#include <omp.h>
#endif

#include "batched_kernels.h"
#include "model0d_core.h"
{% block solver_includes %}{% endblock %}

#if defined(_WIN32)
#define BK_API __declspec(dllexport)
#else
#define BK_API __attribute__((visibility("default")))
#endif

{% block options_type %}
enum { BK_OK = 0, BK_STEP_TOO_SMALL = 1, BK_TOO_MANY_STEPS = 2, BK_NOT_FINITE = 3 };

typedef struct {
    double rtol, atol, h_max, h_min, newton_tol;
    int max_newton, max_jacobian_age, finite_difference_jacobian, method;   /* method 0: BE, 1: TR-BDF2 */
    long max_steps;
    int stop_at_outputs;           /* steps end on each run's last output time (bk_set_stop_at_outputs) */
} BkOptions;
{% endblock %}

typedef struct {
    int var;                       /* the one-array variable it drives */
    int n;
    double *t, *v;                 /* breakpoints (increasing) and values */
} BkTrace;

{% block block_type %}
typedef struct {
    const BkKernel *k;
    int n, ni;
    int n_traced;                  /* inputs driven by traces: their slots and traces */
    int *traced_slot;
    const BkTrace **traced;
    int *states, *inputs;          /* model state indices; one-array variable indices */
    double *in;                    /* the inputs, gathered */
    double ta, tb, h;              /* the last accepted step is [ta, tb]; h the next step to try */
    double *ya, *yb, *fa, *fb;     /* states and rates at ta and tb */
    double *scale;                 /* largest |y| so far */
    double *y, *f, *g, *dx, *ftmp, *y1, *c, *fz;
    double *J, *lu;
    int *piv;
    double lu_h;                   /* the a of the factors of I - a J */
    double crate;                  /* Newton's rate of convergence, from earlier iterations */
    int rejected_last;
    double origin;                 /* the kernels see time t - origin */
    double t_stop;                 /* no step past this: the run's last output time, or INFINITY */
    int jacobian_valid, jacobian_age, active;
    long steps, rejected, newton_failures, rates_calls, jacobians, fd_jacobians, factorisations, run_steps;
    int status;
    double fail_t;
} BkBlock;
{% endblock %}

typedef struct {
    int n_blocks, n_states, n_variables;
    BkBlock *blocks;
    BkOptions opt;
    int n_traces;
    BkTrace **traces;
    double origin;
} BkSim;

{% block solver_name %}
/* The solver this library integrates with. */
BK_API const char *bk_solver_name(void) { return "BE_batched_c"; }
{% endblock %}

BK_API int bk_kernel_count(void) { return BK_KERNEL_COUNT; }
BK_API int bk_kernel_states(int k) { return BK_KERNELS[k].n_states; }
BK_API int bk_kernel_inputs(int k) { return BK_KERNELS[k].n_inputs; }
BK_API int bk_kernel_nonzeros(int k) { return BK_KERNELS[k].nonzeros; }

BK_API void bk_kernel_rates(int k, double t, const double *y, const double *in, double *dy)
{
    BK_KERNELS[k].rates(t, y, in, dy);
}

BK_API void bk_kernel_jacobian(int k, double t, const double *y, const double *in, double *J)
{
    memset(J, 0, sizeof(double) * BK_KERNELS[k].n_states * BK_KERNELS[k].n_states);
    BK_KERNELS[k].jacobian(t, y, in, J);
}

static double *bk_zeros(int n) { return (double *) calloc(n > 0 ? n : 1, sizeof(double)); }

BK_API BkSim *bk_create(int n_blocks, const int *kernel, const int *state_offsets, const int *states,
                        const int *input_offsets, const int *inputs, int n_states, int n_variables)
{
    BkSim *sim = (BkSim *) calloc(1, sizeof(BkSim));
    sim->n_blocks = n_blocks;
    sim->n_states = n_states;
    sim->n_variables = n_variables;
    sim->blocks = (BkBlock *) calloc(n_blocks, sizeof(BkBlock));
{% block default_options %}
    sim->opt.rtol = 1e-4;
    sim->opt.atol = 1e-12;
    sim->opt.h_max = INFINITY;
    sim->opt.h_min = 0.0;
    sim->opt.newton_tol = 0.01;
    sim->opt.max_newton = 6;
    sim->opt.max_jacobian_age = 50;
    sim->opt.max_steps = 10000000;
{% endblock %}
    for (int b = 0; b < n_blocks; ++b) {
        BkBlock *B = &sim->blocks[b];
        B->k = &BK_KERNELS[kernel[b]];
        B->n = state_offsets[b + 1] - state_offsets[b];
        B->ni = input_offsets[b + 1] - input_offsets[b];
        int n = B->n;
        B->states = (int *) malloc(sizeof(int) * (n > 0 ? n : 1));
        memcpy(B->states, states + state_offsets[b], sizeof(int) * n);
        B->inputs = (int *) malloc(sizeof(int) * (B->ni > 0 ? B->ni : 1));
        memcpy(B->inputs, inputs + input_offsets[b], sizeof(int) * B->ni);
        B->in = bk_zeros(B->ni);
        B->traced_slot = (int *) calloc(B->ni > 0 ? B->ni : 1, sizeof(int));
        B->traced = (const BkTrace **) calloc(B->ni > 0 ? B->ni : 1, sizeof(BkTrace *));
{% block block_alloc %}
        B->ya = bk_zeros(n); B->yb = bk_zeros(n); B->fa = bk_zeros(n); B->fb = bk_zeros(n);
        B->scale = bk_zeros(n);
        B->y = bk_zeros(n); B->f = bk_zeros(n); B->g = bk_zeros(n); B->dx = bk_zeros(n);
        B->ftmp = bk_zeros(n); B->y1 = bk_zeros(n); B->c = bk_zeros(n); B->fz = bk_zeros(n);
        B->crate = 1.0;
        B->J = bk_zeros(n * n); B->lu = bk_zeros(n * n);
        B->piv = (int *) calloc(n > 0 ? n : 1, sizeof(int));
        B->lu_h = NAN;
{% endblock %}
    }
    return sim;
}

static void bk_free_trace(BkTrace *tr)
{
    if (tr) {
        free(tr->t);
        free(tr->v);
        free(tr);
    }
}

/* Every block reading a variable with a trace takes it from that trace; blocks whose traced inputs change
   restart at their next run. */
static void bk_attach_traces(BkSim *sim)
{
    for (int b = 0; b < sim->n_blocks; ++b) {
        BkBlock *B = &sim->blocks[b];
        int before = B->n_traced;
        B->n_traced = 0;
        for (int k = 0; k < B->ni; ++k)
            for (int r = 0; r < sim->n_traces; ++r)
                if (sim->traces[r]->var == B->inputs[k]) {
                    B->traced_slot[B->n_traced] = k;
                    B->traced[B->n_traced++] = sim->traces[r];
                }
        if (before || B->n_traced)
            B->active = 0;
    }
}

/* Drives variable var by the trace (t[i], v[i]), i < n, t increasing, from the next run on (replacing any
   trace it had). */
BK_API void bk_set_trace(BkSim *sim, int var, int n, const double *t, const double *v)
{
    BkTrace *tr = (BkTrace *) calloc(1, sizeof(BkTrace));
    tr->var = var;
    tr->n = n;
    tr->t = (double *) malloc(sizeof(double) * (n > 0 ? n : 1));
    tr->v = (double *) malloc(sizeof(double) * (n > 0 ? n : 1));
    memcpy(tr->t, t, sizeof(double) * n);
    memcpy(tr->v, v, sizeof(double) * n);
    int r = 0;
    while (r < sim->n_traces && sim->traces[r]->var != var)
        ++r;
    if (r < sim->n_traces) {
        bk_free_trace(sim->traces[r]);
    } else {
        sim->traces = (BkTrace **) realloc(sim->traces, sizeof(BkTrace *) * (sim->n_traces + 1));
        sim->n_traces++;
    }
    sim->traces[r] = tr;
    bk_attach_traces(sim);
}

/* Variable var is no longer driven by a trace (its value in the variables array applies again). */
BK_API void bk_clear_trace(BkSim *sim, int var)
{
    for (int r = 0; r < sim->n_traces; ++r)
        if (sim->traces[r]->var == var) {
            bk_free_trace(sim->traces[r]);
            sim->traces[r] = sim->traces[--sim->n_traces];
            bk_attach_traces(sim);
            return;
        }
}

/* The trace at model time t: linear between breakpoints, its end values outside them. */
static double bk_trace_at(const BkTrace *tr, double t)
{
    if (tr->n == 0)
        return NAN;
    if (t <= tr->t[0])
        return tr->v[0];
    if (t >= tr->t[tr->n - 1])
        return tr->v[tr->n - 1];
    int lo = 0, hi = tr->n - 1;
    while (hi - lo > 1) {
        int mid = (lo + hi) / 2;
        if (tr->t[mid] <= t)
            lo = mid;
        else
            hi = mid;
    }
    double s = (t - tr->t[lo]) / (tr->t[hi] - tr->t[lo]);
    return tr->v[lo] + s * (tr->v[hi] - tr->v[lo]);
}

BK_API void bk_destroy(BkSim *sim)
{
    if (!sim)
        return;
    for (int b = 0; b < sim->n_blocks; ++b) {
        BkBlock *B = &sim->blocks[b];
        free(B->states); free(B->inputs); free(B->in); free(B->traced_slot); free((void *) B->traced);
{% block block_free %}
        free(B->ya); free(B->yb); free(B->fa); free(B->fb); free(B->scale);
        free(B->y); free(B->f); free(B->g); free(B->dx); free(B->ftmp); free(B->y1); free(B->c); free(B->fz);
        free(B->J); free(B->lu); free(B->piv);
{% endblock %}
    }
    for (int r = 0; r < sim->n_traces; ++r)
        bk_free_trace(sim->traces[r]);
    free(sim->traces);
    free(sim->blocks);
    free(sim);
}

BK_API void bk_set_options(BkSim *sim, double rtol, double atol, double h_max, double h_min, double newton_tol,
                           int max_newton, int max_jacobian_age, long max_steps, int finite_difference_jacobian,
                           int method)
{
    sim->opt.method = method;
    sim->opt.rtol = rtol;
    sim->opt.atol = atol;
    sim->opt.h_max = h_max > 0.0 ? h_max : INFINITY;
    sim->opt.h_min = h_min;
    sim->opt.newton_tol = newton_tol;
    sim->opt.max_newton = max_newton;
    sim->opt.max_jacobian_age = max_jacobian_age;
    sim->opt.max_steps = max_steps;
    sim->opt.finite_difference_jacobian = finite_difference_jacobian;
{% block options_changed %}{% endblock %}
}

{% block stop_at_outputs %}
/* Whether steps end on each run's last output time (0, the default: they may pass it, and outputs are
   interpolated). On, a block whose inputs change between runs keeps its step size, Jacobian and LU factors. */
BK_API void bk_set_stop_at_outputs(BkSim *sim, int on) { sim->opt.stop_at_outputs = on; }
{% endblock %}

/* Every block restarts at its next run, from the states it is given, and forgets the sizes its states
   reached (the states were set from outside). */
BK_API void bk_invalidate(BkSim *sim)
{
    for (int b = 0; b < sim->n_blocks; ++b) {
        sim->blocks[b].active = 0;
{% block invalidate_block %}
        memset(sim->blocks[b].scale, 0, sizeof(double) * sim->blocks[b].n);
{% endblock %}
    }
}

/* The kernels see time t - origin from now on (each sub-experiment's clock can start at 0): a block that reads
   time restarts if its origin moves; the others keep their steps, which are on the runtime's own clock. */
BK_API void bk_set_time_origin(BkSim *sim, double origin)
{
    sim->origin = origin;
    for (int b = 0; b < sim->n_blocks; ++b) {
        BkBlock *B = &sim->blocks[b];
        if ((B->k->reads_time || B->n_traced) && B->origin != origin)
            B->active = 0;
        B->origin = origin;
    }
}

/* The traced inputs at runtime clock t. */
static void bk_apply_traces(BkBlock *B, double t)
{
    for (int r = 0; r < B->n_traced; ++r)
        B->in[B->traced_slot[r]] = bk_trace_at(B->traced[r], t - B->origin);
}

/* The first trace breakpoint after runtime clock t, or INFINITY. */
static double bk_next_breakpoint(const BkBlock *B, double t)
{
    double next = INFINITY, eps = 1e-12 * (fabs(t) + 1.0);
    for (int r = 0; r < B->n_traced; ++r) {
        const BkTrace *tr = B->traced[r];
        for (int i = 0; i < tr->n; ++i) {
            double tb = tr->t[i] + B->origin;
            if (tb > t + eps) {
                if (tb < next)
                    next = tb;
                break;
            }
        }
    }
    return next;
}

static int bk_finite(const double *x, int n)
{
    for (int i = 0; i < n; ++i)
        if (!isfinite(x[i]))
            return 0;
    return 1;
}

/* The block's inputs from the variables (traced ones excepted, which their traces drive); 1 if any changed. */
static int bk_gather_inputs(BkBlock *B, const double *variables)
{
    int changed = 0;
    for (int k = 0; k < B->ni; ++k) {
        int traced = 0;
        for (int r = 0; r < B->n_traced; ++r)
            traced |= B->traced_slot[r] == k;
        if (traced)
            continue;              /* driven by its trace, not by the variables */
        double v = variables[B->inputs[k]];
        if (!(v == B->in[k]) && !(isnan(v) && isnan(B->in[k])))
            changed = 1;
        B->in[k] = v;
    }
    return changed;
}
{% block integrator %}

static double bk_weight(const BkOptions *o, const BkBlock *B, int i, double y)
{
    double s = fabs(y) > B->scale[i] ? fabs(y) : B->scale[i];
    return 1.0 / (o->rtol * s + o->atol);
}

static void bk_rates(BkBlock *B, double t, const double *y, double *f)
{
    if (B->n_traced)
        bk_apply_traces(B, t);
    B->k->rates(t - B->origin, y, B->in, f);
    B->rates_calls++;
}

/* df/dy at (t, y), whose rates are f: the kernel's exact Jacobian, or forward differences where it is not
   finite (an exact derivative can be 0/0 at an extreme state where the rates themselves are finite). */
static void bk_jacobian(const BkOptions *o, BkBlock *B, double t, const double *y, const double *f)
{
    int n = B->n;
    if (B->n_traced)
        bk_apply_traces(B, t);
    if (!o->finite_difference_jacobian) {
        memset(B->J, 0, sizeof(double) * n * n);
        B->k->jacobian(t - B->origin, y, B->in, B->J);
        B->jacobians++;
        if (bk_finite(B->J, n * n))
            return;
    }
    memcpy(B->y1, y, sizeof(double) * n);
    for (int j = 0; j < n; ++j) {
        double yj = y[j];
        double d = 1e-7 * (fabs(yj) + B->scale[j]) + 1e-12;
        B->y1[j] = yj + d;
        bk_rates(B, t, B->y1, B->ftmp);
        for (int i = 0; i < n; ++i)
            B->J[i * n + j] = (B->ftmp[i] - f[i]) / d;
        B->y1[j] = yj;
    }
    B->fd_jacobians++;
}

/* LU factors (partial pivoting) of I - h J; 0 if singular. */
static int bk_factor(BkBlock *B, double h)
{
    int n = B->n;
    double *a = B->lu;
    for (int i = 0; i < n * n; ++i)
        a[i] = -h * B->J[i];
    for (int i = 0; i < n; ++i)
        a[i * n + i] += 1.0;
    for (int c = 0; c < n; ++c) {
        int p = c;
        double best = fabs(a[c * n + c]);
        for (int i = c + 1; i < n; ++i)
            if (fabs(a[i * n + c]) > best) {
                best = fabs(a[i * n + c]);
                p = i;
            }
        if (!(best > 0.0)) {
            B->lu_h = NAN;
            return 0;
        }
        B->piv[c] = p;
        if (p != c)
            for (int j = 0; j < n; ++j) {
                double tmp = a[c * n + j];
                a[c * n + j] = a[p * n + j];
                a[p * n + j] = tmp;
            }
        double pivot = a[c * n + c];
        for (int i = c + 1; i < n; ++i) {
            double m = a[i * n + c] / pivot;
            a[i * n + c] = m;
            if (m != 0.0)
                for (int j = c + 1; j < n; ++j)
                    a[i * n + j] -= m * a[c * n + j];
        }
    }
    B->lu_h = h;
    B->factorisations++;
    return 1;
}

/* Solves (I - h J) x = dx in place with the factors: row interchanges first, then the triangular solves. */
static void bk_solve(BkBlock *B)
{
    int n = B->n;
    const double *a = B->lu;
    double *x = B->dx;
    for (int c = 0; c < n; ++c) {
        int p = B->piv[c];
        if (p != c) {
            double tmp = x[c];
            x[c] = x[p];
            x[p] = tmp;
        }
    }
    for (int c = 0; c < n; ++c)
        for (int i = c + 1; i < n; ++i)
            x[i] -= a[i * n + c] * x[c];
    for (int i = n - 1; i >= 0; --i) {
        double s = x[i];
        for (int j = i + 1; j < n; ++j)
            s -= a[i * n + j] * x[j];
        x[i] = s / a[i * n + i];
    }
}

/* Whether the factors serve for I - a J: made for the same a, up to rounding (a step ending on t_stop is
   t_stop - tb, which can differ from the last in its last bits). */
static int bk_factored_for(const BkBlock *B, double a)
{
    return fabs(a - B->lu_h) <= 1e-9 * a;
}

/* Modified Newton on y - c - a f(t1, y) = 0 from the y in B->y (c in B->c). On success B->f holds the stage's
   rate, (y - c) / a. */
static int bk_newton(const BkOptions *o, BkBlock *B, double t1, double a, int fresh)
{
    int n = B->n;
    double previous = 0.0;
    for (int it = 0; it < o->max_newton; ++it) {
        bk_rates(B, t1, B->y, B->f);
        for (int i = 0; i < n; ++i)
            B->g[i] = B->y[i] - B->c[i] - a * B->f[i];
        if (!bk_finite(B->g, n))
            return 0;
        if (fresh || !B->jacobian_valid) {
            bk_jacobian(o, B, t1, B->y, B->f);
            B->jacobian_valid = 1;
            B->jacobian_age = 0;
            B->lu_h = NAN;
            B->crate = 1.0;
            fresh = 0;
        }
        if (!bk_factored_for(B, a) && !bk_factor(B, a))
            return 0;
        for (int i = 0; i < n; ++i)
            B->dx[i] = -B->g[i];
        bk_solve(B);
        double norm = 0.0;
        for (int i = 0; i < n; ++i) {
            double r = fabs(B->dx[i]) * bk_weight(o, B, i, B->y[i]);
            if (!(r <= norm))
                norm = r;
            B->y[i] += B->dx[i];
        }
        if (isnan(norm))
            return 0;
        if (it > 0)
            B->crate = fmax(0.3 * B->crate, norm / previous);
        if (norm * fmin(1.0, B->crate) <= o->newton_tol) {
            for (int i = 0; i < n; ++i)
                B->f[i] = (B->y[i] - B->c[i]) / a;
            return 1;
        }
        if (it > 0 && norm > 2.0 * previous)
            return 0;      /* diverging */
        if (it > 0 && norm > 0.5 * previous && B->jacobian_age > 0)
            fresh = 1;     /* a kept Jacobian that no longer contracts the iteration well is redone */
        previous = norm;
    }
    return 0;
}

/* A stage: Newton from the predictor in B->y, and again from y0 with a new Jacobian if a kept one fails. */
static int bk_stage(const BkOptions *o, BkBlock *B, double t1, double a)
{
    int stale = B->jacobian_valid && (B->jacobian_age >= o->max_jacobian_age);
    memcpy(B->y1, B->y, sizeof(double) * B->n);
    if (bk_newton(o, B, t1, a, stale))
        return 1;
    if (B->jacobian_age == 0)
        return 0;
    memcpy(B->y, B->yb, sizeof(double) * B->n);
    return bk_newton(o, B, t1, a, 1);
}

/* A first step that changes no state by more than a tenth of its tolerance at the current rates. */
static double bk_first_step(const BkOptions *o, BkBlock *B)
{
    /* Hairer, Norsett & Wanner's starting step (Solving ODEs I, II.4), with weighted RMS norms over all the block's
       states, so a state starting at zero (whose weight is 1/atol) does not force a step too small to resolve. */
    int n = B->n;
    double p = o->method == 0 ? 1.0 : 2.0;
    double d0 = 0.0, d1 = 0.0;
    for (int i = 0; i < n; ++i) {
        double w = bk_weight(o, B, i, B->yb[i]);
        d0 += (B->yb[i] * w) * (B->yb[i] * w);
        d1 += (B->fb[i] * w) * (B->fb[i] * w);
    }
    d0 = sqrt(d0 / n);
    d1 = sqrt(d1 / n);
    double h0 = (d0 < 1e-5 || d1 < 1e-5) ? 1e-6 : 0.01 * d0 / d1;
    if (h0 > o->h_max)
        h0 = o->h_max;
    for (int i = 0; i < n; ++i)
        B->y[i] = B->yb[i] + h0 * B->fb[i];        /* an Euler step, to estimate the second derivative */
    bk_rates(B, B->tb + h0, B->y, B->f);
    double d2 = 0.0;
    for (int i = 0; i < n; ++i) {
        double e = (B->f[i] - B->fb[i]) * bk_weight(o, B, i, B->yb[i]);
        d2 += e * e;
    }
    d2 = sqrt(d2 / n) / h0;
    double m = d1 > d2 ? d1 : d2;
    double h1 = m <= 1e-15 ? fmax(1e-6, 1e-3 * h0) : pow(0.01 / m, 1.0 / (p + 1.0));
    double h = 100.0 * h0 < h1 ? 100.0 * h0 : h1;
    double resolvable = 64.0 * DBL_EPSILON * fabs(B->tb);   /* a step t + h must differ from t */
    if (!isfinite(h))
        h = 1.0;
    if (h < resolvable)
        h = resolvable;
    if (h > o->h_max)
        h = o->h_max;
    return h > o->h_min ? h : (o->h_min > 0.0 ? o->h_min : 1e-300);
}

/* Restarts from the given states at t. soft: only the inputs changed, at the end of the block's last step, so
   its step size, Jacobian and factors are kept (Newton redoes them if they no longer serve). */
static void bk_restart(const BkOptions *o, BkBlock *B, const double *states, double t, int soft)
{
    for (int i = 0; i < B->n; ++i) {
        B->yb[i] = states[B->states[i]];
        B->ya[i] = B->yb[i];
        if (fabs(B->yb[i]) > B->scale[i])
            B->scale[i] = fabs(B->yb[i]);
    }
    B->ta = B->tb = t;
    bk_rates(B, t, B->yb, B->fb);
    memcpy(B->fa, B->fb, sizeof(double) * B->n);
    B->active = 1;
    if (soft)
        return;
    B->h = bk_first_step(o, B);
    B->jacobian_valid = 0;
}

/* The weighted max-norm of the error estimate in B->dx. */
static double bk_error(const BkOptions *o, const BkBlock *B)
{
    double err = 0.0;
    for (int i = 0; i < B->n; ++i) {
        double e = fabs(B->dx[i]) * bk_weight(o, B, i, B->y[i]);
        if (!(e <= err))
            err = e;
    }
    return err;
}

#define BK_GAMMA (2.0 - 1.4142135623730951)
/* Hosea & Shampine's TR-BDF2 local error constant, (-3 g^2 + 4 g - 2) / (12 (2 - g)). */
#define BK_TRBDF2_ERROR (-(3.0 * BK_GAMMA * BK_GAMMA - 4.0 * BK_GAMMA + 2.0) / (12.0 * (2.0 - BK_GAMMA)))

/* One step of size h from tb into B->y and B->f (the rate at its end), with its error estimate in B->dx;
   returns the a of its Newton matrix I - a J, or 0 when Newton failed. */
static double bk_try_step(const BkOptions *o, BkBlock *B, double h)
{
    int n = B->n;
    if (o->method == 0) {
        for (int i = 0; i < n; ++i) {
            B->c[i] = B->yb[i];
            B->y[i] = B->yb[i] + h * B->fb[i];             /* explicit Euler predictor */
        }
        if (!bk_stage(o, B, B->tb + h, h))
            return 0.0;
        for (int i = 0; i < n; ++i)
            B->dx[i] = 0.5 * h * (B->f[i] - B->fb[i]);
        return h;
    }
    double g = BK_GAMMA, a = 0.5 * BK_GAMMA * h;
    for (int i = 0; i < n; ++i) {
        B->c[i] = B->yb[i] + a * B->fb[i];                 /* trapezoidal stage to tb + g h */
        B->y[i] = B->yb[i] + g * h * B->fb[i];
    }
    if (!bk_stage(o, B, B->tb + g * h, a))
        return 0.0;
    memcpy(B->fz, B->f, sizeof(double) * n);
    double w = 1.0 / (g * (2.0 - g)), v = (1.0 - g) * (1.0 - g) * w;
    for (int i = 0; i < n; ++i) {
        B->c[i] = w * B->y[i] - v * B->yb[i];               /* BDF2 stage to tb + h */
        B->y[i] = B->c[i] + a * B->fz[i];
    }
    if (!bk_stage(o, B, B->tb + h, a))
        return 0.0;
    for (int i = 0; i < n; ++i)
        B->dx[i] = 2.0 * BK_TRBDF2_ERROR * h
                   * (B->fb[i] / g - B->fz[i] / (g * (1.0 - g)) + B->f[i] / (1.0 - g));
    return a;
}

/* One accepted step from tb. */
static int bk_advance(const BkOptions *o, BkBlock *B)
{
    int n = B->n;
    double order = o->method == 0 ? 1.0 : 2.0;
    double h = B->h < o->h_max ? B->h : o->h_max;
    for (;;) {
        if (++B->run_steps > o->max_steps)
            return BK_TOO_MANY_STEPS;
        if (h < o->h_min || B->tb + h == B->tb)
            return BK_STEP_TOO_SMALL;
        if (B->n_traced) {
            double next = bk_next_breakpoint(B, B->tb);   /* end the step on the trace's next breakpoint */
            if (B->tb + h > next)
                h = next - B->tb;
        }
        double wanted = h, rest = B->t_stop - B->tb;
        if (rest <= 1.1 * h)
            h = rest;                /* end on t_stop, stretching the step by up to 10% to get there */
        else if (rest <= 2.2 * h)
            h = 0.5 * rest;          /* two equal steps to t_stop rather than a step and a sliver */
        double a = bk_try_step(o, B, h);
        if (a == 0.0) {
            B->rejected++;
            B->newton_failures++;
            B->rejected_last = 1;
            h *= 0.25;
            continue;
        }
        double err = bk_error(o, B);
        if (!(err <= 1.0) && B->jacobian_valid && (bk_factored_for(B, a) || bk_factor(B, a))) {
            bk_solve(B);         /* filtered only when needed: it can only lower a stiff mode's error */
            err = bk_error(o, B);
        }
        if (!(err <= 1.0)) {
            B->rejected++;
            B->rejected_last = 1;
            h *= isnan(err) ? 0.25 : fmax(0.2, 0.9 * pow(err, -1.0 / (order + 1.0)));
            continue;
        }
        memcpy(B->ya, B->yb, sizeof(double) * n);
        memcpy(B->fa, B->fb, sizeof(double) * n);
        memcpy(B->yb, B->y, sizeof(double) * n);
        memcpy(B->fb, B->f, sizeof(double) * n);
        for (int i = 0; i < n; ++i)
            if (fabs(B->y[i]) > B->scale[i])
                B->scale[i] = fabs(B->y[i]);
        B->ta = B->tb;
        B->tb += h;
        B->steps++;
        B->jacobian_age++;
        double grow = err > 0.0 ? fmin(4.0, 0.9 * pow(err, -1.0 / (order + 1.0))) : 4.0;
        int after_rejection = B->rejected_last;
        if (after_rejection || (grow >= 1.0 && grow <= 1.2))
            grow = fmin(grow, 1.0);  /* h, and so the factors, kept unless it can grow by more than 20% */
        B->rejected_last = 0;
        B->h = fmin(h * grow, o->h_max);
        if (h < wanted && !after_rejection && grow >= 1.0 && B->h < wanted)
            B->h = wanted;           /* a step cut short for t_stop does not shrink the next */
        return BK_OK;
    }
}

/* The states at t in [ta, tb], into out at the model's state indices: cubic Hermite from both ends. */
static void bk_interpolate(const BkBlock *B, double t, double *out)
{
    double dt = B->tb - B->ta;
    if (dt <= 0.0) {
        for (int i = 0; i < B->n; ++i)
            out[B->states[i]] = B->yb[i];
        return;
    }
    double s = (t - B->ta) / dt;
    s = s < 0.0 ? 0.0 : (s > 1.0 ? 1.0 : s);
    double s2 = s * s, s3 = s2 * s;
    double h00 = 2 * s3 - 3 * s2 + 1, h10 = s3 - 2 * s2 + s, h01 = -2 * s3 + 3 * s2, h11 = s3 - s2;
    for (int i = 0; i < B->n; ++i)
        out[B->states[i]] = h00 * B->ya[i] + h10 * dt * B->fa[i] + h01 * B->yb[i] + h11 * dt * B->fb[i];
}

static void bk_run_block(const BkOptions *o, BkBlock *B, double *states, const double *variables, double t0,
                         int n_out, const double *t_out, double *out, int n_states)
{
    int inputs_only = B->active && o->stop_at_outputs;   /* if anything changed, only the inputs did */
    int changed = bk_gather_inputs(B, variables) || !B->active;
    double eps = 1e-12 * (fabs(t0) + 1.0);
    B->t_stop = o->stop_at_outputs && n_out > 0 ? t_out[n_out - 1] : INFINITY;
    if (!changed && !(B->ta - eps <= t0 && t0 <= B->tb + eps))
        changed = 1;            /* not where the last run left this block */
    if (changed)                /* soft only at the end of its own step, never from an interpolated state */
        bk_restart(o, B, states, t0, inputs_only && fabs(t0 - B->tb) <= eps);
    B->status = BK_OK;
    B->run_steps = 0;
    for (int k = 0; k < n_out; ++k) {
        double t = t_out[k];
        double tol = 1e-12 * (fabs(t) + 1.0);
        while (B->tb < t - tol) {
            int status = bk_advance(o, B);
            if (status != BK_OK) {
                B->status = status;
                B->fail_t = B->tb;
                B->active = 0;
                return;
            }
        }
        if (out)
            bk_interpolate(B, t, out + (size_t) k * n_states);
    }
    bk_interpolate(B, n_out > 0 ? t_out[n_out - 1] : t0, states);
}
{% endblock %}

/* Integrates every block from t0 through the output times t_out (increasing, from t0), writing the states at
   each into out (n_out x n_states, row major; NULL for none) and the states at the last into states.
   Returns the number of blocks that failed (bk_block_status says which and why). */
BK_API int bk_run(BkSim *sim, double *states, const double *variables, double t0, int n_out, const double *t_out,
                  double *out, int threads)
{
    int failed = 0;
#ifdef _OPENMP
    #pragma omp parallel for schedule(dynamic, 1) num_threads(threads > 0 ? threads : 1) reduction(+:failed)
#endif
    for (int b = 0; b < sim->n_blocks; ++b) {
        bk_run_block(&sim->opt, &sim->blocks[b], states, variables, t0, n_out, t_out, out, sim->n_states);
        failed += sim->blocks[b].status != BK_OK;
    }
    (void) threads;
    return failed;
}

BK_API int bk_block_status(BkSim *sim, int b, double *fail_t)
{
    *fail_t = sim->blocks[b].fail_t;
    return sim->blocks[b].status;
}

{% block stats %}
/* Totals over the blocks: steps, rejected steps, rate evaluations, exact Jacobians, finite-difference
   Jacobians, LU factorisations, Newton failures (rejected steps whose Newton iteration did not converge). */
BK_API void bk_stats(BkSim *sim, long *out)
{
    memset(out, 0, sizeof(long) * 7);
    for (int b = 0; b < sim->n_blocks; ++b) {
        BkBlock *B = &sim->blocks[b];
        out[0] += B->steps; out[1] += B->rejected; out[2] += B->rates_calls;
        out[3] += B->jacobians; out[4] += B->fd_jacobians; out[5] += B->factorisations;
        out[6] += B->newton_failures;
    }
}
{% endblock %}

BK_API int bk_openmp_threads(void)
{
#ifdef _OPENMP
    return omp_get_max_threads();
#else
    return 0;
#endif
}

/* libCellML's own functions, for initial values, computed constants and the algebraic variables. */
BK_API void bk_initialise(double *states, double *rates, double *variables)
{
    initialiseVariables(states, rates, variables);
}

/* Computed constants, and the states libCellML initialises from them. */
BK_API void bk_compute_computed_constants(double *states, double *rates, double *variables)
{
    computeComputedConstants(0.0, states, rates, variables);
}

/* As bk_outputs, with each traced variable at its trace's value at the row's time (on the model's clock). */
BK_API void bk_sim_outputs(BkSim *sim, int n_rows, const double *t, const double *states_rows,
                           const double *variables, double *variables_rows, int threads)
{
#ifdef _OPENMP
    #pragma omp parallel for schedule(static) num_threads(threads > 0 ? threads : 1)
#endif
    for (int r = 0; r < n_rows; ++r) {
        double *s = (double *) malloc(sizeof(double) * (STATE_COUNT > 0 ? STATE_COUNT : 1));
        double *rt = (double *) malloc(sizeof(double) * (STATE_COUNT > 0 ? STATE_COUNT : 1));
        double *v = variables_rows + (size_t) r * VARIABLE_COUNT;
        memcpy(s, states_rows + (size_t) r * STATE_COUNT, sizeof(double) * STATE_COUNT);
        memcpy(v, variables, sizeof(double) * VARIABLE_COUNT);
        if (sim->n_traces) {
            for (int k = 0; k < sim->n_traces; ++k)
                v[sim->traces[k]->var] = bk_trace_at(sim->traces[k], t[r] - sim->origin);
            /* computed constants along the trace; the states libCellML initialises with them are scratch */
            computeComputedConstants(t[r] - sim->origin, rt, rt, v);
        }
        computeRates(t[r] - sim->origin, s, rt, v);
        computeVariables(t[r] - sim->origin, s, rt, v);
        free(s);
        free(rt);
    }
    (void) threads;
}

/* The variables at each output row: a copy of variables per row, then libCellML's computeRates and
   computeVariables at that row's time and states. */
BK_API void bk_outputs(int n_rows, const double *t, const double *states_rows, const double *variables,
                       double *variables_rows, int threads)
{
#ifdef _OPENMP
    #pragma omp parallel for schedule(static) num_threads(threads > 0 ? threads : 1)
#endif
    for (int r = 0; r < n_rows; ++r) {
        double *s = (double *) malloc(sizeof(double) * (STATE_COUNT > 0 ? STATE_COUNT : 1));
        double *rt = (double *) malloc(sizeof(double) * (STATE_COUNT > 0 ? STATE_COUNT : 1));
        double *v = variables_rows + (size_t) r * VARIABLE_COUNT;
        memcpy(s, states_rows + (size_t) r * STATE_COUNT, sizeof(double) * STATE_COUNT);
        memcpy(v, variables, sizeof(double) * VARIABLE_COUNT);
        computeRates(t[r], s, rt, v);
        computeVariables(t[r], s, rt, v);
        free(s);
        free(rt);
    }
    (void) threads;
}

/* Instances: one copy of the whole model with its own states and variables (one-array), advanced step by step
   by its caller, from any thread (an instance is used by one thread at a time; instances share nothing but
   the kernels). For a program that keeps many copies of a model, adds and removes them and changes their
   parameters between steps, such as a game's cells. */
typedef struct {
    BkSim *sim;
    double *states, *rates, *variables, *scratch;
    double t;
} BkInstance;

/* A new instance at t = 0 with the model's initial values and computed constants, integrating the blocks listed
   (indices into the model's blocks; all of them when blocks is NULL): a program that keeps one part of a model
   (one module of a module array) steps only that part's states. */
BK_API BkInstance *bk_instance_create_blocks(int n_blocks, const int *blocks)
{
    BkInstance *I = (BkInstance *) calloc(1, sizeof(BkInstance));
    if (!blocks) {
        I->sim = bk_create(BK_BLOCK_COUNT, BK_BLOCK_KERNEL, BK_BLOCK_STATE_OFFSETS, BK_BLOCK_STATES,
                           BK_BLOCK_INPUT_OFFSETS, BK_BLOCK_INPUTS, (int) STATE_COUNT, (int) VARIABLE_COUNT);
    } else {
        int ns = 0, ni = 0;
        for (int k = 0; k < n_blocks; ++k) {
            ns += BK_BLOCK_STATE_OFFSETS[blocks[k] + 1] - BK_BLOCK_STATE_OFFSETS[blocks[k]];
            ni += BK_BLOCK_INPUT_OFFSETS[blocks[k] + 1] - BK_BLOCK_INPUT_OFFSETS[blocks[k]];
        }
        int *kernel = (int *) malloc(sizeof(int) * (n_blocks + 1));
        int *so = (int *) malloc(sizeof(int) * (n_blocks + 1)), *io = (int *) malloc(sizeof(int) * (n_blocks + 1));
        int *st = (int *) malloc(sizeof(int) * (ns + 1)), *in = (int *) malloc(sizeof(int) * (ni + 1));
        so[0] = io[0] = 0;
        for (int k = 0; k < n_blocks; ++k) {
            int b = blocks[k];
            int bs = BK_BLOCK_STATE_OFFSETS[b], be = BK_BLOCK_STATE_OFFSETS[b + 1];
            int is = BK_BLOCK_INPUT_OFFSETS[b], ie = BK_BLOCK_INPUT_OFFSETS[b + 1];
            kernel[k] = BK_BLOCK_KERNEL[b];
            memcpy(st + so[k], BK_BLOCK_STATES + bs, sizeof(int) * (be - bs));
            memcpy(in + io[k], BK_BLOCK_INPUTS + is, sizeof(int) * (ie - is));
            so[k + 1] = so[k] + (be - bs);
            io[k + 1] = io[k] + (ie - is);
        }
        I->sim = bk_create(n_blocks, kernel, so, st, io, in, (int) STATE_COUNT, (int) VARIABLE_COUNT);
        free(kernel); free(so); free(io); free(st); free(in);
    }
    I->states = bk_zeros((int) STATE_COUNT);
    I->rates = bk_zeros((int) STATE_COUNT);
    I->scratch = bk_zeros((int) STATE_COUNT);
    I->variables = bk_zeros((int) VARIABLE_COUNT);
    initialiseVariables(I->states, I->rates, I->variables);
    computeComputedConstants(0.0, I->states, I->rates, I->variables);
    return I;
}

/* The block that holds a state (an index into the model's blocks). */
BK_API int bk_state_block(int state)
{
    for (int b = 0; b < BK_BLOCK_COUNT; ++b)
        for (int i = BK_BLOCK_STATE_OFFSETS[b]; i < BK_BLOCK_STATE_OFFSETS[b + 1]; ++i)
            if (BK_BLOCK_STATES[i] == state)
                return b;
    return -1;
}

/* A new instance of the whole model. */
BK_API BkInstance *bk_instance_create(void)
{
    return bk_instance_create_blocks(0, NULL);
}

{% block instance_copy_doc %}
/* A copy of an instance: time, states, variables, options and each block's steps, so it continues exactly as
   the original would. */
{% endblock %}
BK_API BkInstance *bk_instance_copy(const BkInstance *src)
{
    int nb = src->sim->n_blocks;
    int *blocks = (int *) malloc(sizeof(int) * (nb + 1));
    for (int b = 0; b < nb; ++b)
        blocks[b] = bk_state_block(src->sim->blocks[b].states[0]);
    BkInstance *I = bk_instance_create_blocks(nb, blocks);
    free(blocks);
    I->sim->opt = src->sim->opt;
    I->t = src->t;
    memcpy(I->states, src->states, sizeof(double) * STATE_COUNT);
    memcpy(I->variables, src->variables, sizeof(double) * VARIABLE_COUNT);
{% block instance_copy_blocks %}
    for (int b = 0; b < I->sim->n_blocks; ++b) {
        const BkBlock *S = &src->sim->blocks[b];
        BkBlock *B = &I->sim->blocks[b];
        size_t n = sizeof(double) * B->n;
        memcpy(B->in, S->in, sizeof(double) * B->ni);
        memcpy(B->ya, S->ya, n); memcpy(B->yb, S->yb, n); memcpy(B->fa, S->fa, n); memcpy(B->fb, S->fb, n);
        memcpy(B->scale, S->scale, n);
        memcpy(B->J, S->J, n * B->n); memcpy(B->lu, S->lu, n * B->n);
        memcpy(B->piv, S->piv, sizeof(int) * B->n);
        B->ta = S->ta; B->tb = S->tb; B->h = S->h; B->lu_h = S->lu_h; B->crate = S->crate;
        B->rejected_last = S->rejected_last; B->origin = S->origin;
        B->jacobian_valid = S->jacobian_valid; B->jacobian_age = S->jacobian_age; B->active = S->active;
    }
{% endblock %}
    return I;
}

BK_API void bk_instance_destroy(BkInstance *I)
{
    if (!I)
        return;
    bk_destroy(I->sim);
    free(I->states); free(I->rates); free(I->scratch); free(I->variables);
    free(I);
}

/* The instance's arrays, for the caller to read and write: STATE_COUNT states, VARIABLE_COUNT variables. After
   writing a state call bk_instance_restart; after writing a constant call bk_instance_parameters_changed. */
BK_API double *bk_instance_states(BkInstance *I) { return I->states; }
BK_API double *bk_instance_variables(BkInstance *I) { return I->variables; }
BK_API double bk_instance_time(const BkInstance *I) { return I->t; }

/* Its options, as bk_set_options. */
BK_API BkSim *bk_instance_sim(BkInstance *I) { return I->sim; }

/* The states were set from outside: integrate afresh from them. */
BK_API void bk_instance_restart(BkInstance *I) { bk_invalidate(I->sim); }

/* Constants changed: recompute the computed constants (libCellML's computeComputedConstants, which also
   initialises some states, so those go to scratch and the instance's states are kept). Blocks that read a
   changed value restart at their next step. */
BK_API void bk_instance_parameters_changed(BkInstance *I)
{
    memcpy(I->scratch, I->states, sizeof(double) * STATE_COUNT);
    computeComputedConstants(I->t, I->scratch, I->rates, I->variables);
}

/* Advances every block by dt (each takes its own steps; inputs are read from the variables, and a block whose
   inputs changed since its last step restarts). Returns the number of blocks that failed. */
BK_API int bk_instance_advance(BkInstance *I, double dt)
{
    double t1 = I->t + dt;
    int failed = 0;
    for (int b = 0; b < I->sim->n_blocks; ++b) {
        bk_run_block(&I->sim->opt, &I->sim->blocks[b], I->states, I->variables, I->t, 1, &t1, NULL,
                     I->sim->n_states);
        failed += I->sim->blocks[b].status != BK_OK;
    }
    I->t = t1;
    return failed;
}

/* Advances n instances by dt each, on OpenMP threads (instances are independent, so the results are the same on
   any number). Returns the number of instances with a failed block. */
BK_API int bk_instances_advance(int n, BkInstance **instances, double dt, int threads)
{
    int failed = 0;
#ifdef _OPENMP
    #pragma omp parallel for schedule(dynamic, 1) num_threads(threads > 0 ? threads : 1) reduction(+:failed)
#endif
    for (int i = 0; i < n; ++i)
        failed += bk_instance_advance(instances[i], dt) != 0;
    (void) threads;
    return failed;
}

/* The outputs chosen when the library was built (bk_output_count, bk_output_index) at the instance's time and
   states, into its variables: the few algebraic variables a caller reads after every step. */
BK_API void bk_instance_outputs(BkInstance *I) { bk_model_outputs(I->t, I->states, I->variables); }

BK_API int bk_output_count(void) { return BK_OUTPUT_COUNT; }
BK_API int bk_output_index(int i) { return BK_OUTPUTS[i]; }

/* The states that name a variable for their initial value take it from the instance's variables now, and those
   initialised by computed constants are recomputed: a new instance's initial values after its parameters were set
   (a named parameter set, a player's choices). Its blocks start afresh. */
BK_API void bk_instance_initialise_states(BkInstance *I)
{
    for (int i = 0; i < (int) STATE_COUNT; ++i)
        if (BK_STATE_INIT_VAR[i] >= 0)
            I->states[i] = I->variables[BK_STATE_INIT_VAR[i]];
    computeComputedConstants(I->t, I->states, I->rates, I->variables);
    bk_invalidate(I->sim);
}

/* Every algebraic variable at the instance's time and states (libCellML's computeRates and computeVariables),
   into its variables. */
BK_API void bk_instance_compute_variables(BkInstance *I)
{
    computeRates(I->t, I->states, I->rates, I->variables);
    computeVariables(I->t, I->states, I->rates, I->variables);
}

/* The model's variables, for a caller that finds them by name: counts, and each one's name, units, component
   and (for variables) libCellML type (2 constant, 3 computed constant, 4 algebraic, 5 external). */
BK_API int bk_state_count(void) { return (int) STATE_COUNT; }
BK_API int bk_variable_count(void) { return (int) VARIABLE_COUNT; }

BK_API void bk_state_info(int i, const char **name, const char **units, const char **component)
{
    *name = STATE_INFO[i].name;
    *units = STATE_INFO[i].units;
    *component = STATE_INFO[i].component;
}

BK_API int bk_variable_info(int i, const char **name, const char **units, const char **component)
{
    *name = VARIABLE_INFO[i].name;
    *units = VARIABLE_INFO[i].units;
    *component = VARIABLE_INFO[i].component;
    return (int) VARIABLE_INFO[i].type;
}
