{% extends 'batched_runtime.c.j2' %}
{% block description %}
/* Runtime of libcuflynx's CVODES_batched_c solver for {{ model_name }}.
   Generated by libcuflynx.generators.cpp.batched; regenerate instead of editing.

   The kernels, block table, traces, outputs and instance API are BE_batched_c's (batched_runtime.c.j2, which this
   extends), so a caller can swap the two libraries. Each block of states is integrated by its own CVODES:
   - BDF (orders 1 to 5), Newton iteration with a dense LU (SUNLinSol_Dense), the kernel's exact Jacobian (forward
     differences where it is not finite), or CVODES's own difference quotients when finite_difference_jacobian;
   - each block has its own SUNDIALS context, vector, matrix and solver, so blocks share nothing and run on any
     number of OpenMP threads with bit-identical results;
   - a block continues its integration across calls unless something it reads changed (its inputs, the states
     set from outside, a trace or its time origin), when it is reinitialised (CVodeReInit) from the given states;
   - output times are CVODES's interpolants (CV_NORMAL), so steps are not cut at outputs;
   - a traced input's breakpoints are stop times (CVodeSetStopTime), so each step sees one straight piece of it.
   bk_set_options maps onto CVODES: rtol and atol (CVodeSStolerances), h_max and h_min (CVodeSetMaxStep,
   CVodeSetMinStep), newton_tol (CVodeSetNonlinConvCoef), max_newton (CVodeSetMaxNonlinIters), max_jacobian_age
   (CVodeSetJacEvalFrequency), each of the last three CVODES's default when 0; max_steps bounds a block's steps
   in one run, as BE_batched_c's does. method is not used (always BDF). */
{% endblock %}
{% block solver_includes %}

#include <cvodes/cvodes.h>
#include <nvector/nvector_serial.h>
#include <sundials/sundials_config.h>
#include <sunlinsol/sunlinsol_dense.h>
#include <sunmatrix/sunmatrix_dense.h>

#if SUNDIALS_VERSION_MAJOR < 6
#error "CVODES_batched_c needs SUNDIALS 6 or later"
#endif
{% endblock %}
{% block options_type %}
enum { BK_OK = 0, BK_STEP_TOO_SMALL = 1, BK_TOO_MANY_STEPS = 2, BK_NOT_FINITE = 3, BK_CVODES_FAILURE = 4 };

typedef struct {
    double rtol, atol, h_max, h_min, newton_tol;
    int max_newton, max_jacobian_age, finite_difference_jacobian, method;
    long max_steps;
} BkOptions;
{% endblock %}
{% block block_type %}
typedef struct {
    const BkKernel *k;
    int n, ni;
    int n_traced;                  /* inputs driven by traces: their slots and traces */
    int *traced_slot;
    const BkTrace **traced;
    int *states, *inputs;          /* model state indices; one-array variable indices */
    double *in;                    /* the inputs, gathered */
    double origin;                 /* the kernels see time t - origin */
    int active;
    SUNContext ctx;                /* the block's own CVODES: created at its first run */
    void *cv;
    N_Vector y;                    /* the states at t */
    SUNMatrix A;
    SUNLinearSolver LS;
    double t;                      /* where the last run left the block */
    double *Jrow, *ytmp, *ftmp;    /* the kernel's Jacobian (row major); finite-difference scratch */
    int options_stale;             /* bk_set_options since the options were last given to CVODES */
    long run_steps;
    long rates_calls, jacobians, fd_jacobians;
    long counted[6];               /* CVODES's counters before its last CVodeReInit (which zeroes them) */
    int status, flag;              /* flag: CVode's return value at a failure */
    double fail_t;
} BkBlock;
{% endblock %}
{% block solver_name %}
/* The solver this library integrates with. */
BK_API const char *bk_solver_name(void) { return "CVODES_batched_c"; }
{% endblock %}
{% block default_options %}
    sim->opt.rtol = 1e-6;
    sim->opt.atol = 1e-8;
    sim->opt.h_max = INFINITY;
    sim->opt.h_min = 0.0;
    sim->opt.max_steps = 10000000;
{% endblock %}
{% block block_alloc %}
        B->Jrow = bk_zeros(n * n);
        B->ytmp = bk_zeros(n);
        B->ftmp = bk_zeros(n);
{% endblock %}
{% block block_free %}
        if (B->cv) {
            CVodeFree(&B->cv);
            SUNLinSolFree(B->LS);
            SUNMatDestroy(B->A);
            N_VDestroy(B->y);
            SUNContext_Free(&B->ctx);
        }
        free(B->Jrow); free(B->ytmp); free(B->ftmp);
{% endblock %}
{% block options_changed %}
    for (int b = 0; b < sim->n_blocks; ++b)
        sim->blocks[b].options_stale = 1;
{% endblock %}
{% block invalidate_block %}{% endblock %}
{% block stop_at_outputs %}
/* BE_batched_c's setting, accepted so the two libraries stay swappable: CVODES steps past output times and
   interpolates, and restarts from scratch whenever a block's inputs change. */
BK_API void bk_set_stop_at_outputs(BkSim *sim, int on) { (void) sim; (void) on; }
{% endblock %}
{% block integrator %}

/* dy = f(t, y) for CVODES; a non-finite rate is a recoverable failure (CVODES retries with a shorter step). */
static int bk_cv_rates(double t, N_Vector y, N_Vector dy, void *data)
{
    BkBlock *B = (BkBlock *) data;
    double *f = N_VGetArrayPointer(dy);
    if (B->n_traced)
        bk_apply_traces(B, t);
    B->k->rates(t - B->origin, N_VGetArrayPointer(y), B->in, f);
    B->rates_calls++;
    return bk_finite(f, B->n) ? 0 : 1;
}

/* df/dy for CVODES's dense matrix (column major): the kernel's exact Jacobian, or forward differences where it is
   not finite (an exact derivative can be 0/0 at an extreme state where the rates themselves are finite). */
static int bk_cv_jacobian(double t, N_Vector yv, N_Vector fv, SUNMatrix Jm, void *data, N_Vector t1, N_Vector t2,
                          N_Vector t3)
{
    BkBlock *B = (BkBlock *) data;
    int n = B->n;
    const double *y = N_VGetArrayPointer(yv), *f = N_VGetArrayPointer(fv);
    double *J = B->Jrow;
    (void) t1; (void) t2; (void) t3;
    if (B->n_traced)
        bk_apply_traces(B, t);
    memset(J, 0, sizeof(double) * n * n);
    B->k->jacobian(t - B->origin, y, B->in, J);
    B->jacobians++;
    if (!bk_finite(J, n * n)) {
        memcpy(B->ytmp, y, sizeof(double) * n);
        for (int j = 0; j < n; ++j) {
            double d = 1e-7 * fabs(y[j]) + 1e-12;
            B->ytmp[j] = y[j] + d;
            B->k->rates(t - B->origin, B->ytmp, B->in, B->ftmp);
            B->rates_calls++;
            for (int i = 0; i < n; ++i)
                J[i * n + j] = (B->ftmp[i] - f[i]) / d;
            B->ytmp[j] = y[j];
        }
        B->fd_jacobians++;
    }
    double *d = SUNDenseMatrix_Data(Jm);
    for (int j = 0; j < n; ++j)
        for (int i = 0; i < n; ++i)
            d[(size_t) j * n + i] = J[i * n + j];
    return 0;
}

/* CVODES's counters since the last (re)initialisation: steps, error test failures, nonlinear convergence
   failures, linear solver setups, Jacobian evaluations (exact or difference quotients), nonlinear iterations. */
static void bk_cv_counters(const BkBlock *B, long *c)
{
    long v;
    memset(c, 0, sizeof(long) * 6);
    if (!B->cv)
        return;
    CVodeGetNumSteps(B->cv, &v); c[0] = v;
    CVodeGetNumErrTestFails(B->cv, &v); c[1] = v;
    CVodeGetNumNonlinSolvConvFails(B->cv, &v); c[2] = v;
    CVodeGetNumLinSolvSetups(B->cv, &v); c[3] = v;
    CVodeGetNumJacEvals(B->cv, &v); c[4] = v;
    CVodeGetNumNonlinSolvIters(B->cv, &v); c[5] = v;
}

static void bk_cv_options(const BkOptions *o, BkBlock *B)
{
    CVodeSStolerances(B->cv, o->rtol, o->atol);
    CVodeSetMaxStep(B->cv, isfinite(o->h_max) ? o->h_max : 0.0);
    CVodeSetMinStep(B->cv, o->h_min);
    CVodeSetNonlinConvCoef(B->cv, o->newton_tol > 0.0 ? o->newton_tol : 0.1);
    CVodeSetMaxNonlinIters(B->cv, o->max_newton > 0 ? o->max_newton : 3);
    CVodeSetJacEvalFrequency(B->cv, o->max_jacobian_age > 0 ? o->max_jacobian_age : 51);
    CVodeSetJacFn(B->cv, o->finite_difference_jacobian ? NULL : bk_cv_jacobian);
    B->options_stale = 0;
}

/* Integrate afresh from the given states at t: the block's CVODES is created at its first run, reinitialised
   after. Returns CVODES's flag (negative on failure). */
static int bk_cv_restart(const BkOptions *o, BkBlock *B, const double *states, double t)
{
    int flag;
    if (!B->cv) {
#if SUNDIALS_VERSION_MAJOR >= 7
        SUNContext_Create(SUN_COMM_NULL, &B->ctx);
#else
        SUNContext_Create(NULL, &B->ctx);
#endif
        B->y = N_VNew_Serial(B->n, B->ctx);
    }
    double *y = N_VGetArrayPointer(B->y);
    for (int i = 0; i < B->n; ++i)
        y[i] = states[B->states[i]];
    if (!B->cv) {
        B->cv = CVodeCreate(CV_BDF, B->ctx);
        flag = CVodeInit(B->cv, bk_cv_rates, t, B->y);
        if (flag < 0)
            return flag;
        CVodeSetUserData(B->cv, B);
        B->A = SUNDenseMatrix(B->n, B->n, B->ctx);
        B->LS = SUNLinSol_Dense(B->y, B->A, B->ctx);
        flag = CVodeSetLinearSolver(B->cv, B->LS, B->A);
        if (flag < 0)
            return flag;
    } else {
        long c[6];
        bk_cv_counters(B, c);
        for (int q = 0; q < 6; ++q)
            B->counted[q] += c[q];
        flag = CVodeReInit(B->cv, t, B->y);
        if (flag < 0)
            return flag;
#if SUNDIALS_VERSION_MAJOR > 6 || SUNDIALS_VERSION_MINOR >= 5
        CVodeClearStopTime(B->cv);
#else
        CVodeSetStopTime(B->cv, INFINITY);
#endif
    }
    bk_cv_options(o, B);
    B->t = t;
    B->active = 1;
    return 0;
}

static void bk_cv_fail(BkBlock *B, int flag)
{
    B->status = flag == CV_TOO_MUCH_WORK ? BK_TOO_MANY_STEPS : BK_CVODES_FAILURE;
    B->flag = flag;
    B->fail_t = B->t;
    if (B->cv)
        CVodeGetCurrentTime(B->cv, &B->fail_t);
    B->active = 0;
}

static void bk_cv_scatter(const BkBlock *B, double *out)
{
    const double *y = N_VGetArrayPointer(B->y);
    for (int i = 0; i < B->n; ++i)
        out[B->states[i]] = y[i];
}

static void bk_run_block(const BkOptions *o, BkBlock *B, double *states, const double *variables, double t0,
                         int n_out, const double *t_out, double *out, int n_states)
{
    int changed = bk_gather_inputs(B, variables) || !B->active;
    double eps = 1e-12 * (fabs(t0) + 1.0);
    if (!changed && fabs(B->t - t0) > eps)
        changed = 1;            /* not where the last run left this block */
    B->status = BK_OK;
    B->run_steps = 0;
    if (changed) {
        int flag = bk_cv_restart(o, B, states, t0);
        if (flag < 0) {
            bk_cv_fail(B, flag);
            return;
        }
    } else if (B->options_stale) {
        bk_cv_options(o, B);
    }
    for (int k = 0; k < n_out; ++k) {
        double t = t_out[k];
        double tol = 1e-12 * (fabs(t) + 1.0);
        while (B->t < t - tol) {
            if (B->n_traced) {
                double next = bk_next_breakpoint(B, B->t);   /* steps end on the trace's next breakpoint */
                if (isfinite(next))
                    CVodeSetStopTime(B->cv, next);
            }
            long left = o->max_steps - B->run_steps, before, after;
            if (left <= 0) {
                bk_cv_fail(B, CV_TOO_MUCH_WORK);
                return;
            }
            CVodeSetMaxNumSteps(B->cv, left);
            CVodeGetNumSteps(B->cv, &before);
            double reached = B->t;
            int flag = CVode(B->cv, t, B->y, &reached, CV_NORMAL);
            CVodeGetNumSteps(B->cv, &after);
            B->run_steps += after - before;
            if (flag < 0) {
                bk_cv_fail(B, flag);
                return;
            }
            B->t = reached;
        }
        if (out)
            bk_cv_scatter(B, out + (size_t) k * n_states);
    }
    bk_cv_scatter(B, states);
}

/* CVode's return value when block b failed (with status 4, BK_CVODES_FAILURE), else 0. */
BK_API int bk_block_cvodes_flag(BkSim *sim, int b)
{
    return sim->blocks[b].status ? sim->blocks[b].flag : 0;
}
{% endblock %}
{% block stats %}
/* Totals over the blocks: steps, rejected steps (error test and Newton failures), rate evaluations, exact
   Jacobians, finite-difference Jacobians (forward differences where an exact one is not finite, and CVODES's
   difference quotients), linear solver setups (each a factorisation), Newton failures. */
BK_API void bk_stats(BkSim *sim, long *out)
{
    memset(out, 0, sizeof(long) * 7);
    for (int b = 0; b < sim->n_blocks; ++b) {
        BkBlock *B = &sim->blocks[b];
        long c[6];
        bk_cv_counters(B, c);
        for (int q = 0; q < 6; ++q)
            c[q] += B->counted[q];
        out[0] += c[0]; out[1] += c[1] + c[2]; out[2] += B->rates_calls;
        out[3] += B->jacobians; out[4] += B->fd_jacobians + (c[4] - B->jacobians);
        out[5] += c[3]; out[6] += c[2];
    }
}
{% endblock %}
{% block instance_copy_doc %}
/* A copy of an instance: time, states, variables and options. Its blocks start CVODES afresh from the copied
   states at their next step (CVODES's memory is not copied), so it follows its original to the tolerances. */
{% endblock %}
{% block instance_copy_blocks %}{% endblock %}
