# The {{ solver }} library of {{ model_name }}: libCellML's C (model0d_core.c), the generated kernels and the
# runtime. Generated by libcuflynx.generators.cpp.batched; regenerate instead of editing.
cmake_minimum_required(VERSION 3.13)
project({{ target }} C)

if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release)
endif()

add_library({{ target }} SHARED model0d_core.c batched_kernels.c batched_runtime.c)
set_target_properties({{ target }} PROPERTIES C_STANDARD 99 C_VISIBILITY_PRESET hidden POSITION_INDEPENDENT_CODE ON)
# libCellML's code is only called at initialisation and for outputs; the kernels are the hot path.
set_source_files_properties(model0d_core.c PROPERTIES COMPILE_OPTIONS "-O1")
target_compile_options({{ target }} PRIVATE $<$<C_COMPILER_ID:GNU,Clang,AppleClang>:-fno-math-errno>)

find_package(OpenMP COMPONENTS C)
if(OpenMP_C_FOUND)
    target_link_libraries({{ target }} PRIVATE OpenMP::OpenMP_C)
endif()

{% if cvodes %}
# SUNDIALS (CVODES) 6 or later: its CMake config, else its headers and libraries under SUNDIALS_DIR.
if(SUNDIALS_DIR)
    list(APPEND CMAKE_PREFIX_PATH "${SUNDIALS_DIR}")
endif()
find_package(SUNDIALS 6 CONFIG QUIET)
if(SUNDIALS_FOUND AND TARGET SUNDIALS::cvodes)
    target_link_libraries({{ target }} PRIVATE SUNDIALS::cvodes SUNDIALS::nvecserial SUNDIALS::sunmatrixdense
                          SUNDIALS::sunlinsoldense)
    if(TARGET SUNDIALS::core)
        target_link_libraries({{ target }} PRIVATE SUNDIALS::core)
    endif()
else()
    find_path(SUNDIALS_INCLUDE_DIR cvodes/cvodes.h HINTS ${SUNDIALS_DIR} PATH_SUFFIXES include)
    if(NOT SUNDIALS_INCLUDE_DIR)
        message(FATAL_ERROR "SUNDIALS (CVODES) not found: set SUNDIALS_DIR to SUNDIALS 6 or later")
    endif()
    target_include_directories({{ target }} PRIVATE ${SUNDIALS_INCLUDE_DIR})
    # the libraries of the install whose headers were found
    get_filename_component(SUNDIALS_PREFIX "${SUNDIALS_INCLUDE_DIR}" DIRECTORY)
    set(SUNDIALS_LIB_SUFFIXES lib lib64 lib/${CMAKE_LIBRARY_ARCHITECTURE})
    foreach(lib sundials_cvodes sundials_nvecserial sundials_sunmatrixdense sundials_sunlinsoldense)
        find_library(${lib}_LIB ${lib} PATHS ${SUNDIALS_PREFIX} PATH_SUFFIXES ${SUNDIALS_LIB_SUFFIXES}
                     NO_DEFAULT_PATH)
        if(NOT ${lib}_LIB)
            message(FATAL_ERROR "SUNDIALS library ${lib} not found under ${SUNDIALS_PREFIX}")
        endif()
        target_link_libraries({{ target }} PRIVATE ${${lib}_LIB})
    endforeach()
    find_library(sundials_core_LIB sundials_core PATHS ${SUNDIALS_PREFIX} PATH_SUFFIXES ${SUNDIALS_LIB_SUFFIXES}
                 NO_DEFAULT_PATH)
    include(CheckLibraryExists)
    if(sundials_core_LIB)
        set(CMAKE_REQUIRED_LIBRARIES ${sundials_core_LIB})     # SUNDIALS 7 keeps SUNContext there
    endif()
    check_library_exists(${sundials_cvodes_LIB} SUNContext_Create "" SUNDIALS_CVODES_HAS_CONTEXT)
    unset(CMAKE_REQUIRED_LIBRARIES)
    if(NOT SUNDIALS_CVODES_HAS_CONTEXT)
        message(FATAL_ERROR "${sundials_cvodes_LIB} is older than SUNDIALS 6: set SUNDIALS_DIR to SUNDIALS 6 or later")
    endif()
    if(sundials_core_LIB)
        target_link_libraries({{ target }} PRIVATE ${sundials_core_LIB})
    endif()
endif()

{% endif %}
find_library(MATH_LIBRARY m)
if(MATH_LIBRARY)
    target_link_libraries({{ target }} PRIVATE ${MATH_LIBRARY})
endif()
