# SUNDIALS (CVODE). Versions 5, 6 and 7 are supported. Point SUNDIALS_DIR at an install prefix
# (or its lib/cmake/sundials) if it is not found automatically.
if(SUNDIALS_DIR)
    list(APPEND CMAKE_PREFIX_PATH "${SUNDIALS_DIR}")
endif()
find_package(SUNDIALS CONFIG QUIET)
if(SUNDIALS_FOUND AND TARGET SUNDIALS::cvode)
    target_link_libraries(model0d PUBLIC SUNDIALS::cvode SUNDIALS::nvecserial
                          SUNDIALS::sunmatrixdense SUNDIALS::sunlinsoldense)
    if(TARGET SUNDIALS::core)
        target_link_libraries(model0d PUBLIC SUNDIALS::core)
    endif()
    message(STATUS "Using SUNDIALS ${SUNDIALS_VERSION} from CMake config")
else()
    find_path(SUNDIALS_INCLUDE_DIR cvode/cvode.h HINTS ${SUNDIALS_DIR} PATH_SUFFIXES include REQUIRED)
    target_include_directories(model0d PUBLIC ${SUNDIALS_INCLUDE_DIR})
    foreach(lib sundials_cvode sundials_nvecserial sundials_sunmatrixdense sundials_sunlinsoldense)
        find_library(${lib}_LIB ${lib} HINTS ${SUNDIALS_DIR} PATH_SUFFIXES lib lib64 REQUIRED)
        target_link_libraries(model0d PUBLIC ${${lib}_LIB})
    endforeach()
    find_library(sundials_core_LIB sundials_core HINTS ${SUNDIALS_DIR} PATH_SUFFIXES lib lib64)
    if(sundials_core_LIB)
        target_link_libraries(model0d PUBLIC ${sundials_core_LIB})
    endif()
    message(STATUS "Using SUNDIALS from ${SUNDIALS_INCLUDE_DIR}")
