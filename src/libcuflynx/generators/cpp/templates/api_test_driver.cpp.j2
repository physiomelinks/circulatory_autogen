{% set has_period = api_functions | selectattr('name', 'equalto', 'get_heartbeat_period') | list %}
using namespace {{ namespace }};

namespace {

struct Replay
{
    std::vector<double> t;
    std::vector<std::vector<double>> p;

    bool load(const std::string &file)
    {
        std::ifstream in(file);
        if (!in) {
            return false;
        }
        std::string line;
        while (std::getline(in, line)) {
            if (line.empty() || line[0] == '#' || std::isalpha(static_cast<unsigned char>(line[0]))) {
                continue;
            }
            std::stringstream ss(line);
            std::string item;
            std::vector<double> row;
            while (std::getline(ss, item, ',')) {
                row.push_back(std::stod(item));
            }
            if (row.size() < {{ chambers | length + 1 }}) {
                continue;
            }
            t.push_back(row[0]);
            p.emplace_back(row.begin() + 1, row.begin() + {{ chambers | length + 1 }});
        }
        return !t.empty();
    }

    double at(double time, size_t i) const
    {
        if (time <= t.front()) {
            return p.front()[i];
        }
        if (time >= t.back()) {
            return p.back()[i];
        }
        size_t k = 1;
        while (t[k] < time) {
            ++k;
        }
        double w = (time - t[k - 1]) / (t[k] - t[k - 1]);
        return (1 - w) * p[k - 1][i] + w * p[k][i];
    }
};

// Simple elastance stand-in: p = (E_min + (E_max - E_min) * activation(t)) * (V - V_0), api units.
double activation(double phase, double start, double duration)
{
    double x = phase - start;
    if (x < 0) {
        x += 1.0;
    }
    return (x < duration) ? 0.5 * (1 - std::cos(2 * M_PI * x / duration)) : 0.0;
}

} // namespace

int main(int argc, char *argv[])
{
    std::string replayFile;
    std::string outFile = "api_test_driver_results.csv";
    double tEnd = 5.0;
    double dt = 1e-3;
    std::string solver = "{{ solver }}";
    for (int i = 1; i + 1 < argc; ++i) {
        std::string a(argv[i]);
        if (a == "-replay") replayFile = argv[++i];
        else if (a == "-tEnd") tEnd = std::stod(argv[++i]);
        else if (a == "-dt") dt = std::stod(argv[++i]);
        else if (a == "-out") outFile = argv[++i];
        else if (a == "-solver") solver = argv[++i];
    }

    {{ class_name }} circulation("", {{ class_name }}::ParentModel::Mechanics, solver);
{% if chambers and has_set_idx and has_get_vol %}
    const {{ chamber_type }} chambers[] = { {% for c in chambers %}{{ chamber_type }}::{{ c.name }}{{ ', ' if not loop.last }}{% endfor %} };
    const char *names[] = { {% for c in chambers %}"{{ c.name }}"{{ ', ' if not loop.last }}{% endfor %} };
    const size_t nChambers = {{ chambers | length }};

    // Round trip of the unit conversions: a pressure set through the api reads back unchanged
    // (up to the intrathoracic offset, which is 0 unless the model sets it).
    circulation.{{ has_set_idx[0].name }}(chambers[0], 80.0);
    std::cout << "set " << names[0] << " pressure 80 -> model value " << std::setprecision(10)
              << circulation.model().variables[{{ chambers[0].pressure_set.name }}] << " (SI)" << std::endl;

    Replay replay;
    const bool useReplay = !replayFile.empty();
    if (useReplay && !replay.load(replayFile)) {
        std::cerr << "could not read replay file " << replayFile << std::endl;
        return 1;
    }

    // stand-in elastance parameters (api units): E_min, E_max, V_0, activation start, duration
    const double Emin[] = { {% for c in chambers %}{{ '0.08' if 'V' in c.name else '0.15' }}{{ ', ' if not loop.last }}{% endfor %} };
    const double Emax[] = { {% for c in chambers %}{{ ('2.5' if c.name == 'LV' else '0.55') if 'V' in c.name else '0.25' }}{{ ', ' if not loop.last }}{% endfor %} };
    const double V0[] = { {% for c in chambers %}{{ '5.0' if 'V' in c.name else '4.0' }}{{ ', ' if not loop.last }}{% endfor %} };
    const double actStart[] = { {% for c in chambers %}{{ '0.15' if 'V' in c.name else '0.0' }}{{ ', ' if not loop.last }}{% endfor %} };
    const double actDuration[] = { {% for c in chambers %}{{ '0.45' if 'V' in c.name else '0.2' }}{{ ', ' if not loop.last }}{% endfor %} };

    std::ofstream out(outFile);
    out << "t";
    for (size_t i = 0; i < nChambers; ++i) out << ",V_" << names[i];
    for (size_t i = 0; i < nChambers; ++i) out << ",p_" << names[i];
    out << "\n";

    double time = circulation.get_time();
    double phase = 0.0;
{% if has_period %}
    double period = circulation.get_heartbeat_period();
{% else %}
    double period = 1.0;
{% endif %}
    while (time < tEnd - 1e-12) {
        const double tNext = time + dt;
        double p[{{ chambers | length }}];
        for (size_t i = 0; i < nChambers; ++i) {
            if (useReplay) {
                p[i] = replay.at(tNext, i);
            } else {
                const double V = circulation.{{ has_get_vol[0].name }}(chambers[i]);
                const double E = Emin[i] + (Emax[i] - Emin[i]) * activation(phase + dt / period, actStart[i], actDuration[i]);
                p[i] = E * (V - V0[i]); // explicit guess
            }
        }
{% set extrap = api_functions | selectattr('kind', 'equalto', 'extrapolate') | list %}
{% if extrap %}
        if (!useReplay) {
            // Implicit coupling: Newton on F(p) = p - E (V(p) - V_0) = 0.
            using Comp = {{ (api.get('chamber_enum') or {}).get('compartment_type', chamber_type) }};
            double E[{{ chambers | length }}];
            for (size_t i = 0; i < nChambers; ++i) {
                E[i] = Emin[i] + (Emax[i] - Emin[i]) * activation(phase + dt / period, actStart[i], actDuration[i]);
            }
            for (int it = 0; it < 20; ++it) {
                std::map<Comp, double> pm;
                for (size_t j = 0; j < nChambers; ++j) {
                    pm[static_cast<Comp>(chambers[j])] = p[j];
                }
                double F[{{ chambers | length }}], J[{{ chambers | length }}][{{ chambers | length }}];
                double res = 0.0;
                for (size_t i = 0; i < nChambers; ++i) {
                    auto vx = circulation.{{ extrap[0].name }}(chambers[i], pm, {}, dt, false, true);
                    F[i] = p[i] - E[i] * (vx.first - V0[i]);
                    for (size_t j = 0; j < nChambers; ++j) {
                        J[i][j] = (i == j ? 1.0 : 0.0) - E[i] * vx.second[static_cast<Comp>(chambers[j])];
                    }
                    res = std::max(res, std::abs(F[i]));
                }
                if (res < 1e-6) {
                    break;
                }
                // Gaussian elimination for J dp = -F
                for (size_t k = 0; k < nChambers; ++k) {
                    for (size_t r = k + 1; r < nChambers; ++r) {
                        double f = J[r][k] / J[k][k];
                        for (size_t c = k; c < nChambers; ++c) J[r][c] -= f * J[k][c];
                        F[r] -= f * F[k];
                    }
                }
                double dp[{{ chambers | length }}];
                for (size_t k = nChambers; k-- > 0;) {
                    double acc = -F[k];
                    for (size_t c = k + 1; c < nChambers; ++c) acc -= J[k][c] * dp[c];
                    dp[k] = acc / J[k][k];
                }
                for (size_t i = 0; i < nChambers; ++i) p[i] += dp[i];
            }
        }
{% endif %}
        for (size_t i = 0; i < nChambers; ++i) {
            circulation.{{ has_set_idx[0].name }}(chambers[i], p[i]);
        }
{% if has_time %}
        circulation.{{ has_time[0].name }}(tNext, 0);
{% endif %}
{% if has_step %}
        circulation.{{ has_step[0].name }}();
{% endif %}
        time = circulation.get_time();
{% if has_period %}
        period = circulation.get_heartbeat_period();
{% endif %}
        phase += dt / period;
        phase -= std::floor(phase);
        out << std::setprecision(12) << time;
        for (size_t i = 0; i < nChambers; ++i) out << "," << circulation.{{ has_get_vol[0].name }}(chambers[i]);
        for (size_t i = 0; i < nChambers; ++i) out << "," << p[i];
        out << "\n";
    }
{% for f in api_functions if f.kind == 'extrapolate' %}

    // Volume extrapolation, as used by an implicit 3D-0D coupling.
    std::map<{{ (api.get('chamber_enum') or {}).get('compartment_type', chamber_type) }}, double> pressures;
    for (size_t i = 0; i < nChambers; ++i) {
        pressures[static_cast<{{ (api.get('chamber_enum') or {}).get('compartment_type', chamber_type) }}>(chambers[i])] = 10.0;
    }
    auto ext = circulation.{{ f.name }}(chambers[1], pressures, {}, dt, false, true);
    std::cout << "extrapolated " << names[1] << " volume " << ext.first << ", dV/dp:";
    for (const auto &kv : ext.second) std::cout << " " << kv.second;
    std::cout << std::endl;
{% endfor %}
    std::cout << "wrote " << outFile << std::endl;
{% else %}
    std::cout << "the api has no indexed chamber functions; nothing to drive" << std::endl;
{% endif %}
    return 0;
}
