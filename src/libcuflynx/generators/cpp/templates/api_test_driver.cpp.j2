// Generated by libcuflynx (template generator): a stand-in for the 3D heart, to test the
// '{{ api.name }}' api without it.
//
//   api_test_driver [-replay pressures.csv] [-tEnd t] [-dt dt] [-out results.csv]
//
// With -replay, chamber pressures (columns: t{% for c in chambers %}, p_{{ c.name }}{% endfor %}; api units) are
// read from a file and set before every step -- e.g. pressures recorded from the 0D-heart model,
// which the volumes returned here should then reproduce. Without it, each chamber's pressure comes
// from a simple time-varying elastance law driven by the model's own heart period, coupled
// implicitly (as lifex does): each step, Newton iterations on the chamber pressures p solve
// p = E(t) (V(p) - V_0), with V(p) and dV/dp from the volume-extrapolation function.
// Writes t{% for c in chambers %}, V_{{ c.name }}{% endfor %}{% for c in chambers %}, p_{{ c.name }}{% endfor %} per step.
#include <cmath>
#include <fstream>
#include <iomanip>
#include <iostream>
#include <map>
#include <sstream>
#include <string>
#include <vector>

#include "circulation_api.h"

{% set p_fac = chamber_units.get('pressure', 1.0) %}
{% set has_set_idx = api_functions | selectattr('kind', 'equalto', 'set_indexed') | list %}
{% set has_get_vol = api_functions | selectattr('kind', 'equalto', 'get_indexed') | selectattr('field', 'equalto', 'volume') | list %}
{% set has_step = api_functions | selectattr('kind', 'equalto', 'step') | list %}
