CF_EXPORT int cf_step(void *handle, double dt)
{
    Handle *h = static_cast<Handle *>(handle);
    try {
        if (dt <= 0.0) {
            return 0;
        }
        if (h->inputsChanged) {
            h->model.reinitialiseSolver();  // the externals jumped: restart the integrator
            h->inputsChanged = false;
        }
        if (h->model.solver_0d == "CVODE") {
            if (h->model.solveOneStep(dt) != 0) {
                return fail(h->model.lastError());
            }
        } else {
            const double dtMax = {{ dt_solver }};
            int nSub = static_cast<int>(std::ceil(dt / dtMax - 1e-9));
            nSub = nSub < 1 ? 1 : nSub;
            for (int k = 0; k < nSub; ++k) {
                if (h->model.solveOneStep(dt / nSub) != 0) {
                    return fail(h->model.lastError());
                }
            }
        }
        refresh(h);
        return 0;
    } catch (const std::exception &e) {
        return fail(std::string("cf_step: ") + e.what());
    }
}

CF_EXPORT int cf_snapshot(void *handle)
{
    Handle *h = static_cast<Handle *>(handle);
    h->snapshots.push_back(h->model.snapshot());
    return 0;
}

// Go back to the last snapshot; keep it when keep != 0 (for further iterations).
CF_EXPORT int cf_restore(void *handle, int keep)
{
    Handle *h = static_cast<Handle *>(handle);
    if (h->snapshots.empty()) {
        return fail("cf_restore: no snapshot");
    }
    h->model.restore(h->snapshots.back());
    if (!keep) {
        h->snapshots.pop_back();
    }
    h->model.reinitialiseSolver();
    h->inputsChanged = false;
    refresh(h);
    return 0;
}

CF_EXPORT int cf_drop_snapshot(void *handle)
{
    Handle *h = static_cast<Handle *>(handle);
    if (!h->snapshots.empty()) {
        h->snapshots.pop_back();
    }
    return 0;
}

CF_EXPORT int cf_open_output(void *handle, const char *dir)
{
    Handle *h = static_cast<Handle *>(handle);
    try {
        h->model.openOutputFiles(std::string(dir));
        h->outputOpen = true;
        return 0;
    } catch (const std::exception &e) {
        return fail(std::string("cf_open_output: ") + e.what());
    }
}

CF_EXPORT int cf_write_output(void *handle)
{
    Handle *h = static_cast<Handle *>(handle);
    if (!h->outputOpen) {
        return fail("cf_write_output: output not open (cf_open_output)");
    }
    h->model.writeOutput(h->model.voi);
    return 0;
}

namespace
