// "vessel/variable" as in the output files (the CellML component is "vessel_module").
bool sameName(const std::string &wanted, const VariableInfo &info)
{
    std::string comp(info.component);
    const std::string suffix = "_module";
    if (wanted == comp + "/" + info.name) {
        return true;
    }
    if (comp.size() > suffix.size() && comp.compare(comp.size() - suffix.size(), suffix.size(), suffix) == 0) {
        comp.resize(comp.size() - suffix.size());
    }
    return wanted == comp + "/" + info.name;
}
} // namespace

// Any 0D state or variable by name ("vessel/variable", as in the output files), for monitoring.
CF_EXPORT int cf_lookup(const char *name, int *is_state)
{
    const std::string wanted(name);
    for (size_t i = 0; i < STATE_COUNT; ++i) {
        if (sameName(wanted, STATE_INFO[i])) {
            *is_state = 1;
            return static_cast<int>(i);
        }
    }
    for (size_t i = 0; i < VARIABLE_COUNT; ++i) {
        if (sameName(wanted, VARIABLE_INFO[i])) {
            *is_state = 0;
            return static_cast<int>(i);
        }
    }
    return fail(std::string("cf_lookup: no state or variable ") + name);
}

CF_EXPORT double cf_value(void *handle, int index, int is_state)
{
    Handle *h = static_cast<Handle *>(handle);
    return is_state ? h->model.states[index] : h->model.variables[index];
}
