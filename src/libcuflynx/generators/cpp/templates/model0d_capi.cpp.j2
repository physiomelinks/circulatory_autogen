CF_EXPORT void *cf_create(const char *ode_solver)
{
    try {
        Handle *h = new Handle();
        h->model.set_ode_solver(ode_solver && *ode_solver ? std::string(ode_solver) : std::string("{{ solver }}"));
        h->model.voi = 0.0;
        h->model.dt = {{ dt_solver }};
