void Model0d::set_ode_solver(std::string ODEsolver)
{
    solver_0d = ODEsolver;
{% if solver == 'CVODE' %}
    if (solver_0d != "CVODE") {
        // explicit schemes need no set-up beyond the work arrays allocated in the constructor
        return;
    }
    // Create our SUNDIALS context and CVODE solver (BDF, dense direct linear solver).
#if SUNDIALS_VERSION_MAJOR >= 7
    SUNContext_Create(SUN_COMM_NULL, &context);
#elif SUNDIALS_VERSION_MAJOR == 6
    SUNContext_Create(NULL, &context);
#endif
#if SUNDIALS_VERSION_MAJOR >= 6
    solver = CVodeCreate(CV_BDF, context);
    y = N_VMake_Serial(STATE_COUNT, states, context);
#else
    solver = CVodeCreate(CV_BDF);
    y = N_VMake_Serial(STATE_COUNT, states);
#endif
    CVodeInit(solver, cvodeRhs, voi, y);
    CVodeSetUserData(solver, this);
    // Set our maximum number of internal steps (solver_info MaximumNumberOfSteps).
    long int mxsteps = {{ n_max_steps }};
    CVodeSetMaxNumSteps(solver, mxsteps);
    // Set our maximum absolute step size (solver_info dt_solver).
    sunrealtype hmax = {{ dt_solver }};
    CVodeSetMaxStep(solver, hmax);
#if SUNDIALS_VERSION_MAJOR >= 6
    matrix = SUNDenseMatrix(STATE_COUNT, STATE_COUNT, context);
    linearSolver = SUNLinSol_Dense(y, matrix, context);
#else
    matrix = SUNDenseMatrix(STATE_COUNT, STATE_COUNT);
    linearSolver = SUNLinSol_Dense(y, matrix);
#endif
    CVodeSetLinearSolver(solver, linearSolver, matrix);
    // Set our scalar relative and absolute tolerances (solver_info rtol/atol).
    sunrealtype reltol = {{ reltol }};
    sunrealtype abstol = {{ abstol }};
    CVodeSStolerances(solver, reltol, abstol);
    nstOld = 0;
    tOld = voi;
{% elif solver == 'PETSC' %}
    // PETSc is not supported by the template generator yet; generate_cpp() refuses it. This body
    // records the settings it would use.
    double reltol = {{ reltol }};
    double abstol = {{ abstol }};
    double dtSolver = {{ dt_solver }};
    (void)reltol; (void)abstol; (void)dtSolver;
{% else %}
    // Fixed-step explicit schemes (explEul / Heun / midpoint / RK4) use the work arrays
    // allocated in the constructor and the Runge-Kutta 4 weights wRK4.
    wRK4[0] = 1. / 6.;
    wRK4[1] = 1. / 3.;
    wRK4[2] = 1. / 3.;
    wRK4[3] = 1. / 6.;
{% endif %}
}
